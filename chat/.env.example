# Copy this file to .env and fill in the values. .env is ignored by git.

# Guesty Booking Engine API key (from the property manager): live availability, prices and reservations
GUESTY_CLIENT_ID=""
GUESTY_CLIENT_SECRET=""

# Email put on direct bookings' Guesty reservations instead of the guest's (guest details stay in our database).
# A mailbox you control, e.g. bookings@yourdomain: Guesty may send its automatic messages there. Not needed with Stripe test keys.
GUESTY_GUEST_EMAIL=""

# Our Stripe account (Developers > API keys). Use the sk_test_/pk_test_ pair to test:
# test keys never create real reservations in Guesty.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe-webhook (event: payment_intent.amount_capturable_updated)
STRIPE_WEBHOOK_SECRET=""

# Set to 1 to take paid bookings on the site; otherwise "Check availability" goes to Airbnb
DIRECT_BOOKING=""

# The site address, used in links sent by email/SMS (e.g. https://bathretreats.co.uk). Defaults to http://localhost:PORT
PUBLIC_URL=""
# "Continue on your phone" links. Email via Resend (resend.com; EMAIL_FROM must use a domain verified there)
RESEND_API_KEY=""
EMAIL_FROM=""
# SMS via Twilio (twilio.com). TWILIO_FROM: a Twilio number (+44...) or an alphanumeric sender ID such as BathRetreat
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Our database (SQLite file). Default chat/data/app.db. In production: a path on a persistent, backed-up disk.
DATABASE_PATH=""

# Password for admin.html (bookings and review approval). Use a long, unique one.
ADMIN_PASSWORD=""

ANTHROPIC_API_KEY=""
